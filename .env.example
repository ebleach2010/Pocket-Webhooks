# ─── Pocket-Webhooks configuration ───────────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# HTTP server
PORT=3000
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Timezone used to interpret dictated appointment times that have no zone
# (Pockey emits e.g. "2026-08-04T11:15:00"). IANA name.
TIMEZONE=America/Boise

# ─── Pockey ──────────────────────────────────────────────────────────────────
# Signing secret shown once when you create the webhook in Pockey's Integrations
# UI. Used to verify the HMAC-SHA256 signature on every delivery.
POCKEY_WEBHOOK_SECRET=

# Optional: Pockey Public API key (pk_...) — only needed for the Claude fallback
# path when full transcript text is required beyond the webhook payload.
POCKEY_API_KEY=

# Reject deliveries whose signed timestamp is older than this many seconds
# (replay protection). Default 300 (5 minutes).
WEBHOOK_MAX_SKEW_SECONDS=300

# ─── Google Calendar ─────────────────────────────────────────────────────────
# OAuth2 client credentials from Google Cloud Console, plus a refresh token
# minted once by `npm run google-auth`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Redirect URI must match the one registered on the OAuth client.
# For `npm run google-auth` the default below works with a "Desktop app" or a
# Web client that lists http://localhost:3000/oauth2/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2/callback
# Calendar to write events to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary
# Default length (minutes) for a timed appointment with no explicit end.
DEFAULT_EVENT_DURATION_MINUTES=60

# ─── Claude (optional) ───────────────────────────────────────────────────────
# Only used for the fallback path: extracting an appointment from free-text when
# a trigger phrase was said but Pockey produced no structured action item.
# Leave ANTHROPIC_API_KEY empty to disable that path entirely.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Storage ─────────────────────────────────────────────────────────────────
# File path for the idempotency + audit store (JSON). Kept out of git.
STORE_PATH=data/store.json
