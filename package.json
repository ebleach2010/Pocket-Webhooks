{
  "name": "pocket-webhooks",
  "version": "0.1.0",
  "private": true,
  "description": "Trigger-word automations for Pockey (Pocket) — receives Pockey webhooks and turns dictated appointments into Google Calendar events.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "google-auth": "tsx scripts/google-auth.ts",
    "send-test-webhook": "tsx scripts/send-test-webhook.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "googleapis": "^144.0.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  }
}
